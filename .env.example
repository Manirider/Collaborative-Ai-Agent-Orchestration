APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Checkpoint mode: "auto" (postgres in production, memory in development), "postgres", or "memory"
CHECKPOINT_MODE=auto

POSTGRES_USER=agent_user
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=agent_db
DATABASE_URL=postgresql+asyncpg://agent_user:replace_with_local_password@db:5432/agent_db

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=

LOG_LEVEL=INFO
LOG_FILE=/app/logs/agent_activity.log

TASK_MAX_RETRIES=3
TASK_RETRY_BACKOFF_SECONDS=2
TASK_TIMEOUT_SECONDS=300

WEBSOCKET_HEARTBEAT_SECONDS=20
WORKSPACE_TTL_SECONDS=86400
